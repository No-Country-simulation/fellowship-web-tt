NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase (proyecto de testimonios, no el de la landing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias de la anon key en proyectos nuevos:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo server. El form y el admin escriben con service_role después de validar.
SUPABASE_SERVICE_ROLE_KEY=

# Emails del equipo, separados por coma. Alternativa: app_metadata.role = admin
ADMIN_EMAILS=

# Discord: inbox interno al enviar; comunidad solo al publicar.
# Si una URL está vacía, ese aviso no se manda.
DISCORD_INBOX_WEBHOOK_URL=
DISCORD_COMMUNITY_WEBHOOK_URL=

# Buffer: Instagram y LinkedIn. Channel IDs del API Explorer
# Por ahora las publicaciones se programan para mañana 12:00 ART (no shareNow).
# https://developers.buffer.com/explorer.html → account.organizations → channels
# Si falta la key o un channel ID, esa red no se ofrece (skipped).
BUFFER_API_KEY=
BUFFER_IG_CHANNEL_ID=
BUFFER_LI_CHANNEL_ID=

# Instagram / Meta (opcional; no se usa — Buffer publica IG/LI)
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Captions IG/LI (Gemini escribe solo el intro)
GEMINI_API_KEY=
# Optional; primary default gemini-3.1-flash-lite, fallback gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
DEV_ADMIN_BYPASS=
NEXT_PUBLIC_APP_URL=
