NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase (proyecto de testimonios, no el de la landing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias de la anon key en proyectos nuevos:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo server. El form y el admin escriben con service_role después de validar.
SUPABASE_SERVICE_ROLE_KEY=

# Emails del equipo, separados por coma. Alternativa: app_metadata.role = admin
ADMIN_EMAILS=

# Discord: inbox interno al enviar; comunidad solo al publicar.
# Si una URL está vacía, ese aviso no se manda.
DISCORD_INBOX_WEBHOOK_URL=
DISCORD_COMMUNITY_WEBHOOK_URL=

# Instagram / Meta (opcional; v1 es caption + link)
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Agent pipeline (copy Gemini + media worker)
GEMINI_API_KEY=
# Optional; primary default gemini-3.1-flash-lite, fallback gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Optional semantic fidelity check (off by default)
# GEMINI_FIDELITY_LLM=true
MEDIA_WEBHOOK_SECRET=
MEDIA_LISTO_WEBHOOK_URL=
FFMPEG_PATH=
WATERMARK_PATH=
DEV_ADMIN_BYPASS=
NEXT_PUBLIC_APP_URL=
