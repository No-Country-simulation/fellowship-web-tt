# Mismo proyecto Supabase que apps/testimonios.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Galería pública (apps/testimonios), para “Ver ficha pública” (/t/{slug}) y el logo de Discord.
# También alimenta el link del formulario que copia el inbox: {GALLERY_URL}/enviar.
# Sin GALLERY_URL en producción ese control se oculta. En local, si falta, se usa http://localhost:3001.
# No es la URL del panel. Esa es ADMIN_PANEL_URL, en apps/testimonios.
GALLERY_URL=http://localhost:3001

# Post al canal de comunidad al publicar. Si está vacío, no se manda.
DISCORD_COMMUNITY_WEBHOOK_URL=

# Buffer: Instagram y LinkedIn.
# https://developers.buffer.com/explorer.html → account.organizations → channels
# development = programar en 1 semana; production = publicar ya (shareNow).
# Si falta la key o un channel ID, esa red no se ofrece.
BUFFER_ENV=development
BUFFER_API_KEY=
BUFFER_IG_CHANNEL_ID=
BUFFER_LI_CHANNEL_ID=
