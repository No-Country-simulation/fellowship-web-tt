# Mismo proyecto Supabase que apps/testimonios.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App pública, para “Ver en la galería” (/t/{slug}).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Post al canal de comunidad al publicar. Si está vacío, no se manda.
DISCORD_COMMUNITY_WEBHOOK_URL=

# Buffer: Instagram y LinkedIn.
# https://developers.buffer.com/explorer.html → account.organizations → channels
# development = programar en 24h; production = publicar ya (shareNow).
# Si falta la key o un channel ID, esa red no se ofrece.
BUFFER_ENV=development
BUFFER_API_KEY=
BUFFER_IG_CHANNEL_ID=
BUFFER_LI_CHANNEL_ID=
